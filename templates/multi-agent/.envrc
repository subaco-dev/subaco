# multi-agent テンプレート — direnv フロー。
# use flake で devShell を有効化し、以降でメモリ（.hive）・実行（.cube）プレーンの
# 初期化と環境変数のエクスポートを行う。use flake 後は devShell のラッパー
# （hive-team 等）が PATH に載る。
watch_file flake.nix flake.lock uv.lock
use flake

# --- メモリプレーン: .hive 初期化と環境変数 ---
# .hive は 0700。初期化の主責務は .envrc / bootstrap（不在時に作成する）。
if [ ! -d .hive ]; then
  mkdir -p .hive
  chmod 700 .hive
fi
# チーム名: .hive/team 不在なら hive-team が導出して 0600 で書く（正規化の唯一実装）。
# hive-team は正規化名を stdout に出すので、それを HIVE_TEAM としてエクスポートする。
export HIVE_DB_PATH="$PWD/.hive/messages.db"
export HIVE_TEAM="$(hive-team)"
export HIVE_LOG_LEVEL="${HIVE_LOG_LEVEL:-info}"

# --- 実行プレーン: .cube 初期化と環境変数 ---
# .cube はシム専用ディレクトリ（.hive とは別・0700・丸ごと gitignore）。
if [ ! -d .cube ]; then
  mkdir -p .cube
  chmod 700 .cube
fi
# 接続設定はいずれもファイル存在時のみエクスポートする（E2B ワイヤ spike で確定した構成。
# E2B_DEBUG / E2B_SANDBOX_URL は不使用）。これはあくまで利便のためのスナップショットで、
# 起動ヘルパー／sandbox_run.py は呼び出し時にトークン／ポートファイルを読み直す
# （再起動でポートが変わっても陳腐化しない）。
if [ -f .cube/token ]; then
  export E2B_API_KEY="$(cat .cube/token)"
fi
# 制御プレーンは 127.0.0.1 の平文 HTTP（データプレーンは create 応答の domain 経由で
# 単一 TLS リスナーに集約されるため、URL のエクスポートは E2B_API_URL のみで足りる）。
if [ -f .cube/port ]; then
  export E2B_API_URL="http://127.0.0.1:$(cat .cube/port)"
fi
# SSL_CERT_FILE は CA バンドル全体を置き換えるため、シムが生成する certifi 結合バンドル
# （certifi + *.sbx.localhost ワイルドカード証明書）を指す。
if [ -f .cube/tls/ca-bundle.pem ]; then
  export SSL_CERT_FILE="$PWD/.cube/tls/ca-bundle.pem"
fi
export SUBACO_SHIM_LOG_LEVEL="${SUBACO_SHIM_LOG_LEVEL:-info}"

# CUBE_TEMPLATE_ID: 共通サンドボックス OCI イメージ（環境プレーンと同一ツールチェーン——
# subaco の sandbox-image パイプラインが 2 アーキ + マニフェストリストとして GHCR へ publish）。
# マニフェストリスト digest 固定で参照し、各ドライバ（podman / Apple Container / wslc）は
# 自ホストのネイティブアーキを digest から自動解決する。
# TODO(release): 初回イメージ公開（subaco の vX.Y タグ push → sandbox-image.yml の
# Job Summary に digest が出る）後に、実 digest へ置換してコメントを外す。
# export CUBE_TEMPLATE_ID="ghcr.io/subaco-dev/subaco-sandbox@sha256:<digest>"
